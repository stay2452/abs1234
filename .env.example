# Runtime: Supabase transaction pooler (port 6543, pgbouncer=true)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations: Supabase session pooler (port 5432) — mesmo host pooler do runtime, porta direta
# (o formato antigo db.<project-ref>.supabase.co:5432 depende de IPv6 e falha em alguns hosts, ex. Render)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Auth (modo prod parte 1, 2026-09-08): segredo da sessao de login (minimo 32 chars).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem ele, login/cadastro falham alto. Nunca commitar o valor real.
SESSION_SECRET="troque-por-64-hex-aleatorios"

# Operador/extensao (opcional, recomendado em prod): token para a extensao e
# chamadas maquina-a-maquina (scrape/run, repair, estimate, import).
# A extensao usa o mesmo valor em chrome.storage.sync.apiToken.
# API_ACCESS_TOKEN="troque-por-token-longo-aleatorio"
